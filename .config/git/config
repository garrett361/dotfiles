[alias]
    b = branch -vv
    bD = branch -D
    bb = bisect bad
    bd = branch -d
    bg = bisect good
    br = bisect reset
    bs = bisect start
    c = commit
    co = checkout
    com = checkout main
    cum = checkout upstream/main
    cp = cherry-pick
    cpa = cherry-pick --abort
    cpc = cherry-pick --continue
    d = diff
    f = fetch
    fum = fetch upstream main
    fom = fetch origin main
    fcum = !git fetch upstream main && git checkout upstream/main
    fcom = !git fetch origin main && git checkout origin/main
    l = log
    m = merge
    ma = merge --abort
    mc = merge --continue
    p = push
    pa = pull --autostash
    pd = push -d
    pf = push --force-with-lease
    pl = pull
    ps = "!f() { git push --set-upstream \"${1:-origin}\" HEAD; }; f"
    pushf = push --force-with-lease
    r = rebase
    ra = rebase --abort
    rau = remote add upstream
    rc = rebase --continue
    rh = reset --hard
    ri = rebase --interactive
    ria = rebase --interactive --autosquash
    rom = rebase origin/main
    rum = rebase upstream/main
    rv = remote -v
    s = stash
    sa = stash apply
    sc = stash clear
    sp = stash pop
    subup = submodule update --init --recursive
    t = tree
    wt = worktree
    wta = worktree add
    wtr = worktree remove
[core]
	# avoid re-walking unchanged dirs each `git status` (big win on virtiofs)
	untrackedCache = true
[credential]
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
[credential "https://huggingface.co"]
	provider = generic
[feature]
	# index v4 (compressed) + skipHash for faster index parse on every git command
	manyFiles = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[user]
	name = Garrett Goon
	email = garrett@primeintellect.ai
[rerere]
	enabled = true
