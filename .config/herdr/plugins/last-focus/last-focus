#!/bin/sh
#
# last-focus: record focus changes and toggle back to the previous workspace or tab.
#
#   last-focus record-workspace   # herdr's workspace.focused event hook
#   last-focus record-tab         # herdr's tab.focused event hook
#   last-focus switch-workspace   # plugin action, tmux's prefix+L
#   last-focus switch-tab         # plugin action, tmux's prefix+l
#
# Each state file is a most-recent-first list, the current place on line 1. Switching fires another
# focus event, so the matching record hook prepends and the top pair swaps, which is what makes
# these toggles. The entries below that pair are what lets a switch still land somewhere when the
# place we came from has since been closed.
#
# Tabs are tracked per workspace, one file each. herdr's built-in last_pane is a single global slot
# at pane granularity, which is neither per workspace nor per tab.

state_dir="${HERDR_PLUGIN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr-last-focus}"

# Enough history that closing a few tabs in a row still leaves somewhere to go back to.
max_history=8

# Pull a field out of the event payload. The payload names the subject of the event, whereas the
# HERDR_* variables describe the invocation context; they agree today but the payload is the one
# that is defined to be about this event. sed rather than jq, which the hook PATH does not promise.
from_json() {
    [ -n "$2" ] || return 0
    printf '%s' "$2" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p"
}

read_line() {
    [ -f "$2" ] || return 0
    sed -n "${1}p" "$2" 2> /dev/null
}

# herdr fires hooks concurrently, so two focus events milliseconds apart can both read the old
# state and lose an update. mkdir is the portable atomic test-and-set.
record() {
    new="$1" file="$2"
    [ -n "$new" ] || return 0
    mkdir -p "$(dirname "$file")" || return 0

    lock="$file.lock"
    i=0
    while ! mkdir "$lock" 2> /dev/null; do
        i=$((i + 1))
        # Rather than drop the update, assume a crashed holder and take the lock.
        if [ "$i" -gt 50 ]; then
            break
        fi
        sleep 0.02
    done
    trap 'rmdir "$lock" 2> /dev/null' EXIT INT TERM

    cur=$(read_line 1 "$file")
    # Re-entering a workspace refocuses its current tab; that must not clobber the way back.
    if [ "$new" != "$cur" ]; then
        tmp="$file.$$"
        # Dropping any earlier copy of the new id keeps the list from growing on a back-and-forth.
        {
            printf '%s\n' "$new"
            grep -vxF -- "$new" "$file" 2> /dev/null | sed '/^$/d'
        } | head -n "$max_history" > "$tmp" && mv "$tmp" "$file"
    fi
}

# Focus the most recent remembered place that still exists, using the focus call itself as the
# liveness test. The old state file held only the current place and the previous one, so closing
# the place we came from left a dead id with nothing behind it, and since a record hook rewrote
# both lines from scratch, the toggle did nothing at all until some unrelated focus change
# happened to displace that id. Walking further down the list is what gives it somewhere to land.
#
# This never writes. A focus call fails the same way whether the target is gone or the server is
# unreachable, so pruning on failure would throw the whole history away on one keypress during an
# outage. Dead ids are displaced by record() prepending and evicted by max_history instead.
switch() {
    file="$1" kind="$2"
    line=2
    while :; do
        prev=$(read_line "$line" "$file")
        [ -n "$prev" ] || break
        if "$herdr_bin" "$kind" focus "$prev" > /dev/null 2>&1; then
            return 0
        fi
        line=$((line + 1))
    done
}

herdr_bin="${HERDR_BIN_PATH:-herdr}"

case "$1" in
    record-workspace)
        ws=$(from_json workspace_id "${HERDR_PLUGIN_EVENT_JSON:-}")
        record "${ws:-$HERDR_WORKSPACE_ID}" "$state_dir/workspace"
        ;;
    record-tab)
        ws=$(from_json workspace_id "${HERDR_PLUGIN_EVENT_JSON:-}")
        tab=$(from_json tab_id "${HERDR_PLUGIN_EVENT_JSON:-}")
        ws="${ws:-$HERDR_WORKSPACE_ID}"
        [ -n "$ws" ] || exit 0
        record "${tab:-$HERDR_TAB_ID}" "$state_dir/tabs/$ws"
        ;;
    switch-workspace)
        switch "$state_dir/workspace" workspace
        ;;
    switch-tab)
        # The action context names the workspace the key was pressed in.
        ws="${HERDR_WORKSPACE_ID:-$(from_json workspace_id "${HERDR_PLUGIN_CONTEXT_JSON:-}")}"
        [ -n "$ws" ] || exit 0
        switch "$state_dir/tabs/$ws" tab
        ;;
    *)
        echo "usage: last-focus record-workspace|record-tab|switch-workspace|switch-tab" >&2
        exit 2
        ;;
esac
