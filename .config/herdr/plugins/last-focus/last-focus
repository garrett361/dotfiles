#!/bin/sh
#
# last-focus: record focus changes and toggle back to the previous workspace or tab.
#
#   last-focus record-workspace   # herdr's workspace.focused event hook
#   last-focus record-tab         # herdr's tab.focused event hook
#   last-focus switch-workspace   # plugin action, tmux's prefix+L
#   last-focus switch-tab         # plugin action, tmux's prefix+l
#
# Each state file is two lines, current then previous. Switching fires another focus event, so the
# matching record hook runs again and swaps the pair, which is what makes these toggles.
#
# Tabs are tracked per workspace, one file each. herdr's built-in last_pane is a single global slot
# at pane granularity, which is neither per workspace nor per tab.

state_dir="${HERDR_PLUGIN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr-last-focus}"

# Pull a field out of the event payload. The payload names the subject of the event, whereas the
# HERDR_* variables describe the invocation context; they agree today but the payload is the one
# that is defined to be about this event. sed rather than jq, which the hook PATH does not promise.
from_json() {
    [ -n "$2" ] || return 0
    printf '%s' "$2" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p"
}

read_line() {
    [ -f "$2" ] || return 0
    sed -n "${1}p" "$2" 2> /dev/null
}

# herdr fires hooks concurrently, so two focus events milliseconds apart can both read the old
# state and lose an update. mkdir is the portable atomic test-and-set.
record() {
    new="$1" file="$2"
    [ -n "$new" ] || return 0
    mkdir -p "$(dirname "$file")" || return 0

    lock="$file.lock"
    i=0
    while ! mkdir "$lock" 2> /dev/null; do
        i=$((i + 1))
        # Rather than drop the update, assume a crashed holder and take the lock.
        if [ "$i" -gt 50 ]; then
            break
        fi
        sleep 0.02
    done
    trap 'rmdir "$lock" 2> /dev/null' EXIT INT TERM

    cur=$(read_line 1 "$file")
    # Re-entering a workspace refocuses its current tab; that must not clobber the way back.
    if [ "$new" != "$cur" ]; then
        tmp="$file.$$"
        printf '%s\n%s\n' "$new" "$cur" > "$tmp" && mv "$tmp" "$file"
    fi
}

herdr_bin="${HERDR_BIN_PATH:-herdr}"

case "$1" in
    record-workspace)
        ws=$(from_json workspace_id "${HERDR_PLUGIN_EVENT_JSON:-}")
        record "${ws:-$HERDR_WORKSPACE_ID}" "$state_dir/workspace"
        ;;
    record-tab)
        ws=$(from_json workspace_id "${HERDR_PLUGIN_EVENT_JSON:-}")
        tab=$(from_json tab_id "${HERDR_PLUGIN_EVENT_JSON:-}")
        ws="${ws:-$HERDR_WORKSPACE_ID}"
        [ -n "$ws" ] || exit 0
        record "${tab:-$HERDR_TAB_ID}" "$state_dir/tabs/$ws"
        ;;
    switch-workspace)
        prev=$(read_line 2 "$state_dir/workspace")
        [ -n "$prev" ] || exit 0
        # A closed workspace makes this fail; leave state alone so the next switch repairs it.
        "$herdr_bin" workspace focus "$prev" > /dev/null 2>&1 || exit 0
        ;;
    switch-tab)
        # The action context names the workspace the key was pressed in.
        ws="${HERDR_WORKSPACE_ID:-$(from_json workspace_id "${HERDR_PLUGIN_CONTEXT_JSON:-}")}"
        [ -n "$ws" ] || exit 0
        prev=$(read_line 2 "$state_dir/tabs/$ws")
        [ -n "$prev" ] || exit 0
        "$herdr_bin" tab focus "$prev" > /dev/null 2>&1 || exit 0
        ;;
    *)
        echo "usage: last-focus record-workspace|record-tab|switch-workspace|switch-tab" >&2
        exit 2
        ;;
esac
