#!/bin/sh
#
# last-workspace: record workspace focus changes and toggle back to the previous one.
#
#   last-workspace record   # run by herdr's workspace.focused event hook
#   last-workspace switch   # run by the plugin action bound to a key
#
# State is two lines, current then previous. `switch` focusing the previous workspace fires another
# workspace.focused, so `record` runs again and swaps the pair, which is what makes it a toggle.

state_dir="${HERDR_PLUGIN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr-last-workspace}"
state="$state_dir/workspaces"
lock="$state_dir/lock"

read_line() {
    [ -f "$state" ] || return 0
    sed -n "${1}p" "$state" 2> /dev/null
}

# herdr fires hooks concurrently, so two focus events milliseconds apart can both read the old
# state and one update is lost. mkdir is the portable atomic test-and-set.
take_lock() {
    i=0
    while ! mkdir "$lock" 2> /dev/null; do
        i=$((i + 1))
        # Rather than drop the update, assume a crashed holder and take the lock.
        if [ "$i" -gt 50 ]; then
            break
        fi
        sleep 0.02
    done
    trap 'rmdir "$lock" 2> /dev/null' EXIT INT TERM
}

case "$1" in
    record)
        # herdr sets HERDR_WORKSPACE_ID for workspace-scoped hooks, but the docs mark it optional,
        # so fall back to the event payload. sed rather than jq, which may not be on the hook PATH.
        new="${HERDR_WORKSPACE_ID:-}"
        if [ -z "$new" ] && [ -n "${HERDR_PLUGIN_EVENT_JSON:-}" ]; then
            new=$(printf '%s' "$HERDR_PLUGIN_EVENT_JSON" \
                | sed -n 's/.*"workspace_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
        fi
        if [ -z "$new" ]; then
            exit 0
        fi

        mkdir -p "$state_dir" || exit 0
        take_lock

        cur=$(read_line 1)
        # Refocusing the current workspace must not clobber the way back.
        if [ "$new" != "$cur" ]; then
            tmp="$state.$$"
            printf '%s\n%s\n' "$new" "$cur" > "$tmp" && mv "$tmp" "$state"
        fi
        ;;
    switch)
        prev=$(read_line 2)
        if [ -z "$prev" ]; then
            exit 0
        fi
        # A closed workspace makes this fail; leave the state alone so the next switch repairs it.
        "${HERDR_BIN_PATH:-herdr}" workspace focus "$prev" > /dev/null 2>&1 || exit 0
        ;;
    *)
        echo "usage: last-workspace record|switch" >&2
        exit 2
        ;;
esac
