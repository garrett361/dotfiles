#!/usr/bin/env bash

if [[ -z $TMUX ]]; then
    echo "slurm_logs requires a tmux session"
    exit 1
fi

format="%.12i %.50j %.8T %.12M %.6D %R"
header=$(squeue --me --format="$format" | head -1)

job_id=$(squeue --me --noheader --format="$format" | fzf --header="$header" | awk '{print $1}')

if [[ -z $job_id ]]; then
    exit 0
fi

job_info=$(scontrol show job "$job_id")
stdout_path=$(echo "$job_info" | grep -oP 'StdOut=\K\S+')
stderr_path=$(echo "$job_info" | grep -oP 'StdErr=\K\S+')

if [[ $stdout_path == "$stderr_path" ]] || [[ -z $stderr_path ]]; then
    if [[ ! -f $stdout_path ]]; then
        echo "Log file does not exist yet: $stdout_path"
        exit 1
    fi
    tail -f "$stdout_path"
else
    stdout_exists=false
    stderr_exists=false
    [[ -f $stdout_path ]] && stdout_exists=true
    [[ -f $stderr_path ]] && stderr_exists=true

    if ! $stdout_exists && ! $stderr_exists; then
        echo "Log files do not exist yet:"
        echo "  stdout: $stdout_path"
        echo "  stderr: $stderr_path"
        exit 1
    fi

    if $stdout_exists && $stderr_exists; then
        tmux split-window -h "tail -f \"$stderr_path\""
        tail -f "$stdout_path"
    elif $stdout_exists; then
        tail -f "$stdout_path"
    else
        tail -f "$stderr_path"
    fi
fi
