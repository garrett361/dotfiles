#!/bin/bash
set -euo pipefail

ORG="PrimeIntellect-ai"
REPOS=(
    prime-rl
    prime-pt
    renderers
    verifiers
)

repo_flags=()
for repo in "${REPOS[@]}"; do
    repo_flags+=(--repo "$ORG/$repo")
done

for role in --assignee --review-requested --reviewed-by; do
    gh search prs "$role" @me --state open "${repo_flags[@]}" \
        --json repository,createdAt,title,url \
        --jq '.[] | "\(.repository.name)\t\(.createdAt)\t\(.title)\t\(.url)"'
done | sort -u | sort -t $'\t' -k1,1 -k2,2 | awk -F '\t' 'NR > 1 { print "" } { print $3; print $4 }'
