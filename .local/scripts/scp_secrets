#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
	echo "Usage: scp_secrets <host>" >&2
	exit 1
fi

host="$1"
local_secrets="$DOTFILES/.secrets"
[[ -f "$local_secrets" ]] || {
	echo "No .secrets file at $local_secrets" >&2
	exit 1
}

rel="${DOTFILES#"$HOME"/}"
remote_secrets="~/$rel/.secrets"

ssh "$host" "test -d ~/$rel/.git" || {
	echo "$host: no dotfiles repo at ~/$rel (clone it, then run get_deps.sh and install.sh there first)" >&2
	exit 1
}

scp "$local_secrets" "$host:$remote_secrets"
ssh "$host" "chmod 600 $remote_secrets"
echo "Copied .secrets to $host:$remote_secrets"
