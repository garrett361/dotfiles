################################   EXPORTS  ################################

export PATH=$PATH:$HOME/.local/bin
export PATH=$PATH:$HOME/.local/scripts

export GITHUB=$HOME/github
export DOTFILES=$GITHUB/garrett361/dotfiles

# Show hidden files and details
export CLICOLOR=1
export LSCOLORS=ExGxBxDxCxEgEdxbxgxcxd

# default editor
export EDITOR="env PYTHONPATH=$PYTHONPATH:$PWD nvim"
export VISUAL="$EDITOR"

# rg
export RIPGREP_CONFIG_PATH="$HOME/.rg"

################################   ALIASES  ################################
alias g="git"

alias v="env PYTHONPATH=$PYTHONPATH:$PWD nvim"

# Show hidden files and details
alias ll="ls -lhA"

# Move to the parent folder.
alias ..="cd ..;pwd"

# Move up two parent folders.
alias ...="cd ../..;pwd"

# Move up three parent folders.
alias ....="cd ../../..;pwd"

# cd into dotfiles
alias cddot="cd ${GITHUB}/garrett361/dotfiles; pwd"

# cd into github
alias cdg="cd ${GITHUB}; pwd"
alias cdgg="cd ${GITHUB}/garrett361; pwd"
alias cdgo="cd ${GITHUB}/goon; pwd"

# Safer rm -rf
alias rmrf="rm -rfI"

# open-shift script aliases

alias l="oc_logs"
alias d="oc_delete"
alias de="oc_describe"
alias dp="oc_describe_pod"
alias r="oc_rsh"


################################   FUNCTIONS  ################################


# make a directory and cd to it
function mcd()
{
    test -d "$1" || mkdir "$1" && cd "$1"
}

# create a file and all intervening directories
function mkfile()
{
    mkdir -p "$(dirname "$1")" && touch "$1"
}

function dotfiles_rebase()
{
    cddot && g f origin main && g r origin/main && cd -
}

function gc()
{
    local repo=$(basename $(pwd))
    git clone git@github.com:$repo/$1 && cd $1
}

function gc_ibm()
{
    local repo=$(basename $(pwd))
    git clone git@github.ibm.com:$repo/$1 && cd $1
}

function vela1()
{
    export KUBECONFIG=~/.kube/config-vela1
    oc projects
}

function vela2()
{
    export KUBECONFIG=~/.kube/config-vela2
    oc projects
}

function hist_edit() {
    local selected_cmd temp_file edited_cmd

    # Get history and let user select with fzf
    selected_cmd=$(fc -l 1 | fzf --tac --no-sort | sed 's/^[[:space:]]*[0-9]*[[:space:]]*//')

    echo "cmd=$selected_cmd"
    # Exit if no selection made
    # [[ -z "$selected_cmd" ]] && return

    # Create temp file and edit
    temp_file=$(mktemp)
    echo "$selected_cmd" > "$temp_file"
    nvim "$temp_file"

    # Read edited command
    edited_cmd=$(cat "$temp_file")
    rm "$temp_file"

    # Put command back on CLI (shell-specific)
    if [[ -n "$ZSH_VERSION" ]]; then
        print -z "$edited_cmd"
    elif [[ -n "$BASH_VERSION" ]]; then
        history -s "$edited_cmd"
        bind '"\C-x\C-a": "\C-a\C-k'"$edited_cmd"'\n"'
        bind '"\C-x\C-x": "\C-x\C-a"'
        read -p "Press Ctrl+X twice to load command: " -n 1
        echo
    fi
}

alias e=hist_edit


################################   OTHER  ################################

[ -f ~/.cargo/env ] && source ~/.cargo/env
