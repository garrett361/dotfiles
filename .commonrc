################################   EXPORTS  ################################

# ~/.local/bin{,/$arch} are already prepended by .zprofile/.profile, which run first.
export PATH=$HOME/.fzf-$(uname -m)/bin:$PATH
export PATH=$PATH:$HOME/.local/scripts

export GITHUB=$HOME/github
export DOTFILES=$GITHUB/garrett361/dotfiles

# Show hidden files and details
export CLICOLOR=1
export LSCOLORS=ExGxBxDxCxEgEdxbxgxcxd

# default editor
export EDITOR="nvim"
export VISUAL="$EDITOR"

# rg
export RIPGREP_CONFIG_PATH="$HOME/.rg"

# fzf: use fd so results respect .gitignore (and are much faster than find)
if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
fi

# cc
export CLAUDE_CODE_MAX_OUTPUT_TOKENS=131072
export CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION=1000

[ -f "$DOTFILES/.secrets" ] && . "$DOTFILES/.secrets"

################################   ALIASES  ################################
alias g="git"

# The trailing colon leaves an empty PYTHONPATH entry, which Python reads as "the current
# directory of whichever process is starting". Nvim ignores it, but the processes nvim spawns
# do not: debugpy and overseer tasks both run `python <file>`, which puts the *script's*
# directory on sys.path rather than the cwd. Without this, debugging or running a script in a
# subdirectory cannot import anything from the project root. The LSP servers (ty, ruff) resolve
# first-party modules from the project root themselves and do not need it.
# Single quotes matter: the expansion has to happen per invocation, not when this file is read.
alias v='env PYTHONPATH="$PYTHONPATH:" nvim'

# Show hidden files and details
alias ll="ls -lhA"

# Move to the parent folder.
alias ..="cd ..;pwd"

# Move up two parent folders.
alias ...="cd ../..;pwd"

# Move up three parent folders.
alias ....="cd ../../..;pwd"

# cd into dotfiles
alias cddot="cd ${GITHUB}/garrett361/dotfiles; pwd"


# cd into github
alias cdg="cd ${GITHUB}; pwd"
alias cdgg="cd ${GITHUB}/garrett361; pwd"
alias cdgo="cd ${GITHUB}/goon; pwd"

# Safer rm -rf
alias rmrf="rm -rfI"

# tmux
alias t="tmux"
alias tua="tmux -u a"
alias ts="tmux-sessionizer"

alias c="claude"
alias x="codex"

# tail/follow from beginnin
alias tf="tail -n +1 -F"

################################   FUNCTIONS  ################################

_open_logs_in_panes() {
    local selected_files="$1"
    [ -z "$selected_files" ] && return 0

    local -a files=()
    while IFS= read -r line; do
        [ -n "$line" ] && files+=("$line")
    done <<< "$selected_files"

    local count=${#files[@]}
    if [ "$count" -gt 4 ]; then
        echo "Maximum 4 files supported. Selected: $count"
        return 1
    fi

    set -- "${files[@]}"
    case $count in
        1)
            tail -n +1 -f "$1"
            ;;
        2)
            tmux split-window -h "tail -n +1 -f \"$2\""
            tail -n +1 -f "$1"
            ;;
        3)
            tmux split-window -h "tail -n +1 -f \"$2\""
            tmux split-window -v "tail -n +1 -f \"$3\""
            tail -n +1 -f "$1"
            ;;
        4)
            tmux split-window -h "tail -n +1 -f \"$2\""
            tmux select-pane -L
            tmux split-window -v "tail -n +1 -f \"$3\""
            tmux select-pane -R
            tmux split-window -v "tail -n +1 -f \"$4\""
            tail -n +1 -f "$1"
            ;;
    esac
}

# make a directory and cd to it
function mcd()
{
    test -d "$1" || mkdir -p "$1" && cd "$1"
}

# create a file and all intervening directories
function mkfile()
{
    mkdir -p "$(dirname "$1")" && touch "$1"
}

function dotfiles_rebase()
{
    cddot && g f origin main && g r origin/main && cd -
}

function _clone_from_host()
{
    local host="$1"
    local repo_name="$2"
    local org
    org=$(basename "$(pwd)")

    if [[ -z "$repo_name" ]]; then
        echo "Usage: gc <repo_name>" >&2
        return 1
    fi

    git clone "git@${host}:${org}/${repo_name}" && cd "$repo_name"
}

function _add_upstream_if_fork()
{
    local host="$1"
    local q url_expr out ret name url

    if ! command -v gh >/dev/null 2>&1; then
        echo "upstream: gh not found; skipping fork check" >&2
        return 0
    fi

    url_expr='"git@'"$host"':\(.parent.owner.login)/\(.parent.name).git"'
    q="[.nameWithOwner, (if .isFork then $url_expr else \"\" end)] | @tsv"
    # gh's errors go to the terminal; capturing them would let a stray line into the remote URL.
    out=$(gh repo view --json isFork,parent,nameWithOwner -q "$q")
    ret=$?
    if [ "$ret" -ne 0 ]; then
        echo "upstream: gh repo view failed; no upstream added" >&2
        return 0
    fi

    name=${out%%$'\t'*}
    url=${out#*$'\t'}
    if [ -z "$url" ]; then
        echo "upstream: $name is not a fork"
        return 0
    fi

    if git remote add upstream "$url"; then
        echo "upstream: added $url"
    else
        echo "upstream: git remote add failed for $url" >&2
    fi
    return 0
}

function gc()
{
    _clone_from_host "github.com" "$1" \
        && _add_upstream_if_fork "github.com"
}


################################   OTHER  ################################

function rc() {
    if [ -n "$ZSH_VERSION" ]; then
        source ~/.zshrc
    elif [ -n "$BASH_VERSION" ]; then
        source ~/.bashrc
    else
        echo "Unknown shell" >&2
        return 1
    fi
}

# Also set in .zprofile/.profile. Neither location alone covers every shell: the profiles miss
# non-login interactive shells (this file's job), and this file misses non-interactive login
# shells like `zsh -lc`. The export is idempotent, so setting it twice costs nothing.
export RUSTUP_HOME="$HOME/.rustup-$(uname -m)"
# Only claims the arch-suffixed tree when it exists; otherwise whatever a profile already exported
# stands, and cargo's own ~/.cargo default applies if nothing did. See the profiles' CARGO_HOME
# comment for why it has to be exported rather than left to rustup's env file.
[ -f "$HOME/.cargo-$(uname -m)/env" ] && export CARGO_HOME="$HOME/.cargo-$(uname -m)"

[ -f "$HOME/.slurm_fns.sh" ] && source "$HOME/.slurm_fns.sh"
[ -f "$HOME/.lsf_fns.sh" ]   && source "$HOME/.lsf_fns.sh"
