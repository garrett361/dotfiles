################################   EXPORTS  ################################

export PATH=$PATH:$HOME/.local/bin
export PATH=$PATH:$HOME/.local/scripts

export GITHUB=$HOME/github
export DOTFILES=$GITHUB/garrett361/dotfiles

# Show hidden files and details
export CLICOLOR=1
export LSCOLORS=ExGxBxDxCxEgEdxbxgxcxd

# default editor
export EDITOR="env PYTHONPATH=$PYTHONPATH:$PWD nvim"
export VISUAL="$EDITOR"

# rg
export RIPGREP_CONFIG_PATH="$HOME/.rg"

# cc
export CLAUDE_CODE_MAX_OUTPUT_TOKENS=131072

################################   ALIASES  ################################
alias g="git"

alias v="env PYTHONPATH=$PYTHONPATH:$PWD nvim"

# Show hidden files and details
alias ll="ls -lhA"

# Move to the parent folder.
alias ..="cd ..;pwd"

# Move up two parent folders.
alias ...="cd ../..;pwd"

# Move up three parent folders.
alias ....="cd ../../..;pwd"

# cd into dotfiles
alias cddot="cd ${GITHUB}/garrett361/dotfiles; pwd"


# cd into github
alias cdg="cd ${GITHUB}; pwd"
alias cdgg="cd ${GITHUB}/garrett361; pwd"
alias cdgo="cd ${GITHUB}/goon; pwd"

# Safer rm -rf
alias rmrf="rm -rfI"

# tmux
alias t="tmux"
alias tua="tmux -u a"
alias ts="tmux-sessionizer"

alias c="claude"
alias x="codex"
################################   FUNCTIONS  ################################

_open_logs_in_panes() {
    local selected_files="$1"
    [ -z "$selected_files" ] && return 0

    local -a files=()
    while IFS= read -r line; do
        [ -n "$line" ] && files+=("$line")
    done <<< "$selected_files"

    local count=${#files[@]}
    if [ "$count" -gt 4 ]; then
        echo "Maximum 4 files supported. Selected: $count"
        return 1
    fi

    set -- "${files[@]}"
    case $count in
        1)
            tail -n +1 -f "$1"
            ;;
        2)
            tmux split-window -h "tail -n +1 -f \"$2\""
            tail -n +1 -f "$1"
            ;;
        3)
            tmux split-window -h "tail -n +1 -f \"$2\""
            tmux split-window -v "tail -n +1 -f \"$3\""
            tail -n +1 -f "$1"
            ;;
        4)
            tmux split-window -h "tail -n +1 -f \"$2\""
            tmux select-pane -L
            tmux split-window -v "tail -n +1 -f \"$3\""
            tmux select-pane -R
            tmux split-window -v "tail -n +1 -f \"$4\""
            tail -n +1 -f "$1"
            ;;
    esac
}

# make a directory and cd to it
function mcd()
{
    test -d "$1" || mkdir -p "$1" && cd "$1"
}

# create a file and all intervening directories
function mkfile()
{
    mkdir -p "$(dirname "$1")" && touch "$1"
}

function dotfiles_rebase()
{
    cddot && g f origin main && g r origin/main && cd -
}

function _clone_from_host()
{
    local host="$1"
    local repo_name="$2"
    local org
    org=$(basename "$(pwd)")

    if [[ -z "$repo_name" ]]; then
        echo "Usage: gc <repo_name>" >&2
        return 1
    fi

    git clone "git@${host}:${org}/${repo_name}" && cd "$repo_name"
}

function _add_upstream_if_fork()
{
    command -v gh &>/dev/null || return 0
    local origin_url host upstream
    origin_url=$(git remote get-url origin 2>/dev/null) || return 0

    # Extract hostname from SSH (git@host:...) or HTTPS (https://host/...)
    if [[ "$origin_url" =~ ^git@([^:]+): ]]; then
        host="${BASH_REMATCH[1]}"
    elif [[ "$origin_url" =~ ^https?://([^/]+)/ ]]; then
        host="${BASH_REMATCH[1]}"
    else
        return 0
    fi

    upstream=$(gh repo view --hostname "$host" --json isFork,parent \
        -q "select(.isFork) | \"https://${host}/\(.parent.owner.login)/\(.parent.name).git\"" \
        2>/dev/null)
    if [[ -n "$upstream" ]]; then
        git remote add upstream "$upstream" && echo "Added upstream: $upstream"
    fi
}

function gc()
{
    _clone_from_host "github.com" "$1" && _add_upstream_if_fork
}

function gc_ibm()
{
    _clone_from_host "github.ibm.com" "$1" && _add_upstream_if_fork
}

function vela1()
{
    export KUBECONFIG=~/.kube/config-vela1
    oc projects
}

function vela2()
{
    export KUBECONFIG=~/.kube/config-vela2
    oc projects
}

function aiu()
{
    export KUBECONFIG=~/.kube/aiu
    oc projects
}


################################   OTHER  ################################

function rc() {
    if [ -n "$ZSH_VERSION" ]; then
        source ~/.zshrc
    elif [ -n "$BASH_VERSION" ]; then
        source ~/.bashrc
    else
        echo "Unknown shell" >&2
        return 1
    fi
}

[ -f ~/.cargo/env ] && source ~/.cargo/env
[ -f "$HOME/.slurm_fns.sh" ] && source "$HOME/.slurm_fns.sh"
[ -f "$HOME/.lsf_fns.sh" ]   && source "$HOME/.lsf_fns.sh"
