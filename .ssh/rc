# sshd runs this for every session, before the requested command and after agent forwarding is set up.
# That is the only hook that also fires for `ssh host <cmd>` and `ssh -t host tmux attach`, neither of
# which sources a login profile.
#
# Each session gets a fresh random socket path, so a tmux pane that outlives the session that started
# it holds a dead one. Keep a single stable name on a live socket instead, and let .profile/.zprofile
# export that name rather than the per-session path.

# Existence is not liveness: an sshd killed without cleanup leaves a real socket behind, which a bare
# -S test would pin forever, and every later session would inherit an unreachable agent. ssh-add exits
# 2 when it cannot reach one. sshd waits on this script, so a socket whose peer is a half-open link
# must not hang the probe and stall every login: bound it where `timeout` exists.
agent_alive() {
	[ -S "$1" ] || return 1
	if command -v timeout >/dev/null 2>&1; then
		SSH_AUTH_SOCK="$1" timeout 2 ssh-add -l >/dev/null 2>&1
	else
		SSH_AUTH_SOCK="$1" ssh-add -l >/dev/null 2>&1
	fi
	# 0 lists keys, 1 is reachable but empty, 2 is unreachable, 124 is the timeout kill.
	case $? in
		0 | 1) return 0 ;;
		*) return 1 ;;
	esac
}

# A live link is left alone so a second concurrent session cannot steal it from the first, whose panes
# would break when the newer session ends.
_stable="$HOME/.ssh/agent.sock"
if [ -n "$SSH_AUTH_SOCK" ] && [ "$SSH_AUTH_SOCK" != "$_stable" ] && [ -S "$SSH_AUTH_SOCK" ] &&
	! agent_alive "$_stable" && { [ ! -e "$_stable" ] || [ -L "$_stable" ]; }; then
	# rename(2) rather than unlink then link, so simultaneous logins cannot race for the name.
	_tmp="$_stable.$$"
	ln -s "$SSH_AUTH_SOCK" "$_tmp" && mv -f "$_tmp" "$_stable"
	unset _tmp
fi
unset _stable

# sshd hands its xauth work to this file instead of doing it itself once the file exists, so X11
# forwarding needs the default handling restored here. Straight from sshd(8), except that sshd calls
# xauth by the absolute XAuthLocation path while this script has only the session PATH, where xauth
# may not appear at all.
if read proto cookie && [ -n "$DISPLAY" ]; then
	_xauth=$(command -v xauth)
	[ -x "$_xauth" ] || _xauth=/opt/X11/bin/xauth
	if [ -x "$_xauth" ]; then
		if [ "$(echo "$DISPLAY" | cut -c1-10)" = "localhost:" ]; then
			echo "add unix:$(echo "$DISPLAY" | cut -c11-) $proto $cookie" | "$_xauth" -q -
		else
			echo "add $DISPLAY $proto $cookie" | "$_xauth" -q -
		fi
	fi
	unset _xauth
fi
